        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SHIPPING_ADDRESS 填收货地址" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
