      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="清理残留 checkout" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import org.apache.http.client.methods.HttpPost
import org.apache.http.entity.StringEntity
import org.apache.http.impl.client.HttpClients
import org.apache.http.util.EntityUtils

// 场景B 每轮都会回收自己创建的 checkout，但「持续时间到点」时最后一轮
// 可能停在创建之后、删除之前，每线程最多残留 1 个。这里统一兜底清理。
// 注意：实测 checkouts 的 filter.search 不匹配 email，只能取回后按前缀过滤。
def url = vars.get('PROTOCOL') + '://' + vars.get('HOST') + ':' + vars.get('PORT') + '/graphql/'
def token = props.get('AUTH_TOKEN')
def http = HttpClients.createDefault()
def slurper = new JsonSlurper()

def call = { String q, Map v ->
    def post = new HttpPost(url)
    post.setHeader('Content-Type', 'application/json')
    if (token) { post.setHeader('Authorization', 'Bearer ' + token) }
    post.setEntity(new StringEntity(JsonOutput.toJson([query: q, variables: v]), 'UTF-8'))
    def resp = http.execute(post)
    def ent = resp.getEntity()
    def text = ent == null ? '' : EntityUtils.toString(ent, 'UTF-8')
    resp.close()
    return slurper.parseText(text)
}

SampleResult.setSuccessful(true)
def listed = call('query($first: Int!) { checkouts(first: $first) { edges { node { id email } } } }', [first: 100])
if (listed.errors) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('tearDown 查询 checkout 失败：' + listed.errors)
    http.close()
    return
}
def targets = []
(listed.data?.checkouts?.edges ?: []).each { e ->
    def email = e.node.email
    if (email != null &amp;&amp; email.startsWith('perf-')) { targets &lt;&lt; e.node.id }
}
def failed = []
targets.each { cid ->
    def r = call('mutation($id: ID!) { checkoutDelete(id: $id) { errors { field message code } } }', [id: cid])
    def errs = r.data?.checkoutDelete?.errors
    if (r.errors || (errs != null &amp;&amp; !errs.isEmpty())) { failed &lt;&lt; cid }
}
http.close()
if (failed) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('tearDown 未清理干净的 checkout：' + failed)
} else {
    SampleResult.setResponseMessage('已清理压测残留 checkout ' + targets.size() + ' 个')
    log.info('tearDown 已清理压测残留 checkout ' + targets.size() + ' 个')
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>