# ===== Saleor GraphQL 接口自动化测试 · 环境变量模板 =====
# 复制本文件为 .env 后按需修改。.env 已被 .gitignore 忽略，不会提交到仓库。

# GraphQL 接口地址
SALEOR_GRAPHQL_URL=http://localhost:8000/graphql/

# 管理员账号（Saleor 官方演示数据默认值，本地开发用）
SALEOR_ADMIN_EMAIL=admin@example.com
SALEOR_ADMIN_PASSWORD=admin

# 默认测试渠道 slug
SALEOR_CHANNEL=default-channel

# 单次请求超时（秒）
SALEOR_TIMEOUT=30

# 单接口响应时间阈值（毫秒），超过则用例失败
SALEOR_MAX_RESPONSE_MS=3000

# 日志级别：DEBUG / INFO / WARNING / ERROR
SALEOR_LOG_LEVEL=INFO

# ===== UI（Dashboard）自动化 =====
# Dashboard 地址
SALEOR_DASHBOARD_URL=http://localhost:9000

# UI 元素等待超时（毫秒）
SALEOR_UI_TIMEOUT_MS=15000

# 是否以有头模式运行（1=显示浏览器窗口，便于调试；0=无头）
SALEOR_UI_HEADED=0