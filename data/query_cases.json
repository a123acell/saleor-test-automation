[
  {
    "id": "DD-Q-001",
    "name": "查询店铺信息（需鉴权）",
    "query": "SHOP",
    "operation": "shop",
    "auth": true,
    "variables": {},
    "expect_data_key": "shop",
    "expect_not_null": ["shop.name", "shop.version", "shop.defaultCountry.code"]
  },
  {
    "id": "DD-Q-002",
    "name": "查询渠道列表（本环境需鉴权）",
    "query": "CHANNELS",
    "operation": "channels",
    "auth": true,
    "variables": {},
    "expect_data_key": "channels",
    "expect_not_null": ["channels"]
  },
  {
    "id": "DD-Q-003",
    "name": "按渠道查询商品列表",
    "query": "PRODUCTS",
    "operation": "products",
    "auth": true,
    "variables": { "channel": "$CHANNEL", "first": 5 },
    "expect_data_key": "products",
    "expect_not_null": ["products.totalCount", "products.edges"]
  },
  {
    "id": "DD-Q-004",
